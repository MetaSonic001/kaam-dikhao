# Kaam Dikhao configuration. Copy to `.env` and fill in. `.env` is git-ignored.
# Only Supabase, Clerk and Groq are needed. Everything else is optional.

# ---- App -------------------------------------------------------------------
APP_ENV=development                    # set to "production" when deployed (disables the dev sign-in header)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Clerk: sign-in (email, phone, Google; free up to 10,000 users) ---------
# Dashboard > API keys. `clerk init --app <app id>` also writes these for you.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...       # server only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Supabase: Postgres + Storage (free tier is enough) ---------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...       # server only, never expose to the browser
# Session-mode pooler string (works over IPv4). Find it under Project settings > Database > Connect.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Groq: LLM, vision and speech-to-text (free tier) ------------------------
GROQ_API_KEY=gsk_...
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3

# ---- Roles and legal contact -------------------------------------------------
ADMIN_EMAILS=you@example.com            # comma separated. These emails get the moderator/admin role on sign-in
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@yourdomain.in   # Grievance Officer shown on /legal (IT Rules 2021)
GRIEVANCE_EMAIL=grievance@yourdomain.in

# ---- Optional ---------------------------------------------------------------
# Local development only: sign in as this user without an email round-trip. Ignored in production.
# NEXT_PUBLIC_DEV_USER=you@example.com
# DATA_GOV_IN_API_KEY=                  # reserved for open government data connectors
# SYNC_ON_STARTUP=true                  # fetch live OpenStreetMap works for cities that have no data yet
# DEFAULT_CITY=mumbai
